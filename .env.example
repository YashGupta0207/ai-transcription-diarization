# ===== General =====
ENV=development                     # development | production
SECRET_KEY=change-me-super-secret
API_KEY_HEADER_NAME=X-API-Key
DESKTOP_API_KEY=dev-desktop-key-change-me

# ===== Database =====
# Dev (SQLite)
DATABASE_URL=sqlite:///./transcribeapp.db
# Prod (Postgres, e.g. Render managed Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ===== Redis / Queue =====
REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=transcription_jobs

# ===== Storage =====
STORAGE_BACKEND=local               # local | b2 | s3
LOCAL_STORAGE_DIR=./storage_data

# Backblaze B2 (S3-compatible) - used when STORAGE_BACKEND=b2 or s3
S3_ENDPOINT_URL=https://s3.us-west-002.backblazeb2.com
S3_BUCKET_NAME=transcribeapp-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-west-002

# ===== AI Providers =====
SPEECH_PROVIDER=gateway             # gateway | azure | deepgram | whisper | openrouter | assemblyai | gladia
DEEPGRAM_API_KEY=
GATEWAY_API_KEY=
GATEWAY_BASE_URL=https://ai-gateway-admin.onrender.com
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
ASSEMBLYAI_API_KEY=
GLADIA_API_KEY=

# ===== Backend URL (used by desktop app) =====
BACKEND_BASE_URL=http://localhost:8000
